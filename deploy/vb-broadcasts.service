[Unit]
Description=vb_data hourly TV/streaming broadcast refresh (ICS calendars + TPS fallback)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# --- host: user + absolute repo path (deployed on ubuntu@mediaserver) ---
User=ubuntu
WorkingDirectory=/home/ubuntu/vb_data
EnvironmentFile=-/home/ubuntu/vb_data/.env
ExecStart=/home/ubuntu/vb_data/scripts/broadcasts_update.sh
# Plain HTTP (a few ICS fetches + optional TPS) -> quick; cap well under the hourly cadence.
TimeoutStartSec=1200
Nice=10

[Install]
WantedBy=multi-user.target
