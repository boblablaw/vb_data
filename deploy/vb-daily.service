[Unit]
Description=vb_data daily incremental scrape + load + derive
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# --- host: user + absolute repo path (deployed on ubuntu@mediaserver) ---
User=ubuntu
WorkingDirectory=/home/ubuntu/vb_data
EnvironmentFile=-/home/ubuntu/vb_data/.env
ExecStart=/home/ubuntu/vb_data/scripts/daily_update.sh
# The full discovery + scrape can take well over an hour early in the season.
TimeoutStartSec=10800
Nice=10

[Install]
WantedBy=multi-user.target
