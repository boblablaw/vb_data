[Unit]
Description=Run vb_data incremental update during game windows (America/New_York)

[Timer]
# Cadence is denser during game windows so scores land soon after matches go final. The scrape is
# idempotent (only new contests are fetched), so extra runs just re-pay the cheap scoreboard
# discovery cost. All times America/New_York.
#
#   Weekday evenings (Mon-Thu): every 30 min, 17:00-23:30 — midweek matches are evening-only.
#   Weekend + Friday (Fri,Sat,Sun): every 45 min, noon-01:30 — dense day+night slates start early.
#
# The weekend early-morning tail (00:00, 00:45, 01:30) lands on Sat,Sun,Mon. The authoritative
# daily full pass is vb-daily.timer at 03:00, clear of every window here.
#
# --- Weekday evenings (Mon-Thu), every 30 min 17:00-23:30 ---
OnCalendar=Mon..Thu *-*-* 17..23:00,30 America/New_York
# --- Weekend + Friday (Fri,Sat,Sun), every 45 min noon-23:15 ---
OnCalendar=Fri,Sat,Sun *-*-* 12,15,18,21:00,45 America/New_York
OnCalendar=Fri,Sat,Sun *-*-* 13,16,19,22:30 America/New_York
OnCalendar=Fri,Sat,Sun *-*-* 14,17,20,23:15 America/New_York
# --- Weekend tail into the next morning (Sat,Sun,Mon), continuing the 45-min grid to 01:30 ---
OnCalendar=Sat,Sun,Mon *-*-* 00:00,45 America/New_York
OnCalendar=Sat,Sun,Mon *-*-* 01:30 America/New_York
Persistent=true
# Small jitter so we are not hammering the site at the same second every run.
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
