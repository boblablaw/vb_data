# Copy to .env and adjust. Postgres runs on host port 5435 (see docker-compose.yml).
# 5432 is a 3-way conflict in this workspace; 5433/5434 are taken by credit-card stacks.
DATABASE_URL=postgresql+psycopg://vb:vb@localhost:5435/vb

# Scrape pacing (stats.ncaa.org / Akamai — go slow)
VB_MIN_DELAY=3
VB_MAX_DELAY=6

# Data locations (relative to repo root)
VB_TEAMS_JSON=data/teams.json
VB_EXPORTS_DIR=exports
